# Anthropic — the Signal, the letter replies, the verse engine.
# Without a key every one of them falls back to a real composition rather
# than an error, so the site works fully unconfigured.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Unsplash — the Clerestory (@cotek photo feed).
# Without it the room lists the photographs by description instead of showing
# them, which is more honest than a grid of grey rectangles.
UNSPLASH_ACCESS_KEY=

# Letters — optional. Without these the Letter Box still composes a reply but
# says plainly that the note was not forwarded.
RESEND_API_KEY=
LETTERS_TO=temi@cotek.live

# Site
SITE_URL=https://cotek.me
